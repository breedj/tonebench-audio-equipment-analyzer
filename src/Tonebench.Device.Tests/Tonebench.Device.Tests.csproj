<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tonebench.Device\Tonebench.Device.csproj" />
    <ProjectReference Include="..\Tonebench.Dsp\Tonebench.Dsp.csproj" />
  </ItemGroup>

  <!-- Needed for the [Trait("Category","Hardware")] tests, which talk to a real Qa40xUsbDevice and
       a real sound card. See Tonebench.App.csproj for why these are vendored here instead of coming
       from NuGet, and packaging/native/portaudio.md for how portaudio.dll is built. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="..\..\native\win-x64\libusb-1.0.dll" Link="libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\native\win-x64\portaudio.dll" Link="portaudio.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
