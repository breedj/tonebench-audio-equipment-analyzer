<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qa403.Device\Qa403.Device.csproj" />
    <ProjectReference Include="..\Qa403.Dsp\Qa403.Dsp.csproj" />
  </ItemGroup>

  <!-- Needed for the [Trait("Category","Hardware")] tests, which talk to a real Qa40xUsbDevice.
       See Qa403.App.csproj for why this is vendored here instead of coming from NuGet. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="..\..\native\win-x64\libusb-1.0.dll" Link="libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
