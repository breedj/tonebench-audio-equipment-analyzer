diff --git a/crates/vqa40x-core/src/analyzer.rs b/crates/vqa40x-core/src/analyzer.rs
index 6df868b..f5ffc66 100644
--- a/crates/vqa40x-core/src/analyzer.rs
+++ b/crates/vqa40x-core/src/analyzer.rs
@@ -546,9 +546,24 @@ impl Analyzer {
             };
             let il = sample(vl, 0);
             let ir = sample(vr, 1);
-            // Wire order is swapped: right sample first.
-            out.extend_from_slice(&ir.to_le_bytes());
+            // Wire order on the ADC is straight through: LEFT sample first.
+            //
+            // The L/R swap is the DAC's alone. Measured on a real QA403 (serial
+            // 1077527945) with the generator and calibration bypassed: driving wire
+            // slot 1 alone returns at -6.00 dBFS on RX slot 0 (slot 1 down at
+            // -94 dBFS), and driving slot 0 alone mirrors it -- so TX slot N comes
+            // back on RX slot 1-N, not on slot N.
+            //
+            // QuantAsylum's own PyQa40x agrees: it swaps the outputs only
+            // (analyzer.py:113) and deinterleaves the ADC straight through
+            // (analyzer.py:174-175, `left = interleaved[0::2]`). ASIO401 agrees too --
+            // its channel swap is applied in CopyToQA40xBuffer (output) while the
+            // input path's swapChannels is false for the QA403. QA40x_BareMetal swaps
+            // both directions, which double-swaps and crosses the channels; it never
+            // caught that because it prints per-channel peaks only, never which
+            // frequency arrived where.
             out.extend_from_slice(&il.to_le_bytes());
+            out.extend_from_slice(&ir.to_le_bytes());
         }
         s.emitted += n as u64;
         out
