<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Qa403.Device\Qa403.Device.csproj" />
    <ProjectReference Include="..\Qa403.Dsp\Qa403.Dsp.csproj" />
    <ProjectReference Include="..\Qa403.Data\Qa403.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" Condition="Exists('wwwroot')" />
  </ItemGroup>

  <!-- LibUsbDotNet 3.x wraps native libusb-1.0, which the NuGet package does not bundle
       (docs/qa403-app-stack-spec.md §2.1/§9.4). Vendored at code/native/win-x64 for now
       (Windows dev machine only); a Linux libusb-1.0.so.0 counterpart is a follow-up. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="..\..\native\win-x64\libusb-1.0.dll" Link="libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
